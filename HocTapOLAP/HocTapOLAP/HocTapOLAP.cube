  <MdxScripts>
    <MdxScript dwd:design-time-name="a1d4db29-384c-4e49-b8c1-4cceef726886">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Điểm trung bình]
 AS IIF([Measures].[Số lượt thi] = 0, NULL, [Measures].[Tổng điểm] / [Measures].[Số lượt thi]),
 FORMAT_STRING = "0.00", ASSOCIATED_MEASURE_GROUP = 'Ket qua thi';
CREATE MEMBER CURRENTCUBE.[Measures].[Điểm chuyên cần]
 AS IIF([Measures].[Số phiên] = 0, NULL, [Measures].[Tổng điểm chuyên cần] / [Measures].[Số phiên]),
 FORMAT_STRING = "0.00", ASSOCIATED_MEASURE_GROUP = 'Chuyen can';</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
