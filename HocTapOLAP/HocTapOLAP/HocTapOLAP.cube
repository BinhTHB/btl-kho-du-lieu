 AS IIF([Measures].[Số phiên] = 0, NULL, [Measures].[Tổng điểm chuyên cần] / [Measures].[Số phiên]),
 FORMAT_STRING = "0.00", ASSOCIATED_MEASURE_GROUP = 'Chuyen can';</Text></Command>
