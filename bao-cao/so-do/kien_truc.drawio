          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="flow_mv_web" value="Đọc nhanh WITH (NOEXPAND)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;dashed=1;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_mv" target="box_bi">
